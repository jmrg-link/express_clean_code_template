# --- Dependencias y artefactos de build ---
node_modules/
dist/
build/
*.tsbuildinfo

# --- Tests y cobertura ---
coverage/
.nyc_output/

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
logs/*
!logs/traefik/
logs/traefik/*
!logs/traefik/.gitkeep

# --- Cache de herramientas ---
.eslintcache
.cache/

# --- OS ---
.DS_Store
Thumbs.db

# --- IDEs ---
.vscode/
.idea/
*.swp

# --- Envs por entorno: NUNCA commit. Solo .env.example. ---
.env
.env.local
.env.staging
.env.production
.env.test
.env.secrets

# --- LocalStack ---
.localstack/

# --- Runtime data (Traefik ACME, Mongo data, Keycloak data) ---
data/*
!data/traefik/
data/traefik/*
!data/traefik/acme/
data/traefik/acme/*
!data/traefik/acme/.gitkeep

# --- Secretos / certificados ---
*.pem
*.key
*.crt
*.p12
secrets/

# --- Backups locales del entorno ---
*.bak
*.bak.*
.env.*.bak
.env.*.bak.*
