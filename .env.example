# =============================================================================
# Plantilla v4. Copia a .env.local / .env.staging / .env.production
# y rellena. Genera secrets con `./scripts/generate-secrets.sh`.
# =============================================================================

# ----- Stack global -----
DOMAIN=localhost
SSL_EMAIL=admin@example.com

# ----- API Express -----
NODE_ENV=local
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api
API_VERSION=v1
CORS_ORIGINS=https://app.localhost

# ----- Mongo -----
MONGODB_URI=mongodb://mongodb:27017/express-clean-backend

# ----- Keycloak admin bootstrap -----
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme

# Variables que la API Express LEE (env.keycloak.*).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=app-api
KEYCLOAK_CLIENT_SECRET=changeme

# Issuer publico (opcional). Cuando KC esta detras de Traefik con
# KC_HOSTNAME, los tokens emitidos llevan `iss=https://auth.<dominio>/...`
# pero la API hace JWKS fetch al URL interno. Sin este override, jwtVerify
# rechaza el token con "issuer mismatch".
KEYCLOAK_PUBLIC_ISSUER=https://auth.localhost/realms/app

# Alias para docker compose (URL interna entre contenedores).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

KC_API_SECRET=changeme
KC_PANELS_SECRET=changeme
OIDC_PLUGIN_SECRET=changeme-32-chars-min

KC_INITIAL_ADMIN_PASSWORD=change-me-on-first-boot
KC_INITIAL_OPERATOR_PASSWORD=change-me-on-first-boot

# ----- JWT fallback -----
JWT_SECRET=changeme-min-16-chars

# ----- S3 -----
# Para AWS real: deja AWS_S3_ENDPOINT vacío + AWS_S3_FORCE_PATH_STYLE=false.
# Las credenciales son opcionales si usas AWS_PROFILE o instance role.
# Para LocalStack: AWS_S3_ENDPOINT=http://localstack:4566 + FORCE_PATH_STYLE=true
# y AWS_ACCESS_KEY_ID/SECRET en literal ('test'/'test').
AWS_REGION=eu-south-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ----- Loki -----
LOKI_HOST=

# ----- Grafana / Traefik dashboard -----
GRAFANA_ADMIN_PASSWORD=changeme
# Formato user:bcrypt-hash. Generalo con `./scripts/generate-secrets.sh`,
# que ya emite los `$` doblados (`$$`) — REQUERIDO para que docker-compose
# v2 NO interprete `$2y` / `$05` / `$<hash>` como referencias a variables.
# Si pegas un hash literal `admin:$2y$05$xxx`, veras: WARN[...] variable not set.
TRAEFIK_AUTH=admin:$$2y$$05$$placeholderplaceholderplaceholder

# ----- RBAC -----
# CSV de patrones admin. Acepta literal `<localpart>@<domain.tld>` o
# wildcard de dominio `*@<domain.tld>`. Lista vacía = política off.
# Configurar los dominios reales solo en .env.<env> (no committeable).
ADMIN_EMAIL_PATTERNS=

# RBAC bootstrap reconciler
# Si true, en cada boot promueve a `admin` los usuarios cuyo email cumpla
# ADMIN_EMAIL_PATTERNS. Idempotente y aditivo (jamás retira roles).
RBAC_BOOTSTRAP_RECONCILE=false
